{
  "name": "french-adventure",
  "version": "1.0.0",
  "description": "French learning game for Jenn and Jess",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test tests/*.test.js && npm run check:handlers",
    "test:watch": "node --test --watch tests/",
    "check:handlers": "node scripts/check-handlers.mjs",
    "check:drift": "node scripts/check-drift.mjs",
    "verify": "npm run test && npm run check:drift",
    "deploy": "npm run build && git add index.html src/ && echo 'built - now: git commit && git push'"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lxyzh1019-cyber/French-Adventure.git"
  },
  "bugs": {
    "url": "https://github.com/lxyzh1019-cyber/French-Adventure/issues"
  },
  "homepage": "https://github.com/lxyzh1019-cyber/French-Adventure#readme",
  "devDependencies": {
    "vite": "^6.4.3",
    "vite-plugin-singlefile": "^2.3.3"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  }
}
